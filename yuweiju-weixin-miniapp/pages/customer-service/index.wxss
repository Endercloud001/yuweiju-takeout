.cs-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f6f6;
}

.cs-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #6E1D20;
  color: #fff;
}

.cs-title {
  font-size: 34rpx;
  font-weight: 600;
}

.cs-status {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.cs-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d9a23b;
  margin-right: 10rpx;
}

.cs-status.online .cs-status-dot {
  background: #39c37f;
}

.cs-list {
  flex: 1;
  padding: 20rpx 32rpx;
}

.cs-load {
  text-align: center;
  margin-bottom: 16rpx;
}

.cs-load-text {
  font-size: 24rpx;
  color: #6E1D20;
}

.cs-message {
  display: flex;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.cs-message.user {
  justify-content: flex-start;
  padding-left: 6rpx;
}

.cs-message.admin {
  justify-content: flex-end;
  padding-right: 12rpx;
}

.cs-message.system {
  justify-content: center;
}

.cs-bubble {
  max-width: 64%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}

.cs-message.admin .cs-bubble {
  background: rgba(110, 29, 32, 0.12);
}

.cs-content {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

.cs-time {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: right;
}

.cs-system {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e6e6e6;
  font-size: 22rpx;
  color: #666;
}

.cs-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 40rpx;
}

.cs-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.cs-textarea {
  flex: 1;
  min-height: 72rpx;
  max-height: 140rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ddd;
  background: #fafafa;
  font-size: 26rpx;
}

.cs-send {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background: #6E1D20;
  color: #fff;
  font-size: 28rpx;
}
